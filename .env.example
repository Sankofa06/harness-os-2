# Harness OS environment configuration example. Copy to .env and adjust.
# No secrets belong in committed files; API keys are referenced through the
# secret store (see SPEC/SECURITY_PRIVACY.md) — env vars are one backend.

# Server bind (default: loopback only)
HARNESS_SERVER__HOST=127.0.0.1
HARNESS_SERVER__PORT=4096

# Data directory (SQLite DB, api token, artifact store). Default: ~/.local/share/harness
# HARNESS_DATA_DIR=/path/to/data

# Auth: local_trust lets loopback clients skip the bearer token (default true).
# Non-loopback clients always require the token from <data_dir>/api_token.
# HARNESS_AUTH__LOCAL_TRUST=true

# Deterministic seeded demo mode (no real credentials or network calls)
# HARNESS_DEMO_MODE=1

# Example of an env-var-backed secret *reference* target (name is arbitrary;
# a secret_ref of kind "env" points at a variable like this):
# MY_PROVIDER_API_KEY=
